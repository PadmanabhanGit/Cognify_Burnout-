<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:gravity="center_vertical"
    android:background="#1F2937"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Time Distribution"
        android:textColor="#F3F4F6"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Work/Study"
                android:textColor="#D1D5DB"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/tv_work_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:text="4h 15m"
                android:textColor="#F3F4F6"
                android:textStyle="bold"
                android:textSize="15sp" />
        </RelativeLayout>
        <ProgressBar
            android:id="@+id/pb_work"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="65"
            android:progressTint="#3B82F6"
            android:progressBackgroundTint="#333333" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Breaks"
                android:textColor="#D1D5DB"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/tv_breaks_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:text="1h 30m"
                android:textColor="#F3F4F6"
                android:textStyle="bold"
                android:textSize="15sp" />
        </RelativeLayout>
        <ProgressBar
            android:id="@+id/pb_breaks"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="23"
            android:progressTint="#10B981"
            android:progressBackgroundTint="#333333" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Distractions"
                android:textColor="#D1D5DB"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/tv_distractions_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:text="45m"
                android:textColor="#F3F4F6"
                android:textStyle="bold"
                android:textSize="15sp" />
        </RelativeLayout>
        <ProgressBar
            android:id="@+id/pb_distractions"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="12"
            android:progressTint="#EF4444"
            android:progressBackgroundTint="#333333" />
    </LinearLayout>

</LinearLayout>
