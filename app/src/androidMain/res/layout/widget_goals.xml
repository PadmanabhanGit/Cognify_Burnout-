<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#1F2937">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Goals for Next Week"
        android:textColor="#3B82F6"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="• Achieve 7.5 hours of sleep on 5+ nights"
        android:textColor="#F3F4F6"
        android:textSize="15sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="• Maintain study sessions within 6 hours daily"
        android:textColor="#F3F4F6"
        android:textSize="15sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="• Limit social media to within 2 hours daily"
        android:textColor="#F3F4F6"
        android:textSize="15sp" />
</LinearLayout>
